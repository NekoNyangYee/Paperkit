# Copy with: bash deploy/init-env.sh, then set your Supabase public settings.
COMPOSE_PROJECT_NAME=paperkit-pi
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME
VITE_API_BASE_URL=https://thkim.tail969319.ts.net/paperkit
PROXY_PORT=18080
# On the Pi, build natively for ARM64. For local x86 Docker tests use linux/amd64.
DOCKER_PLATFORM=linux/arm64
# Exact browser origins, comma separated. Empty denies cross-origin browser access.
CORS_ALLOWED_ORIGINS=http://tauri.localhost,https://tauri.localhost,http://127.0.0.1:1420
REQUESTS_PER_MINUTE=120
