{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main-capability",
  "description": "Minimal capability for the local Paperkit window.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "dialog:allow-open",
    "dialog:allow-save",
    "dialog:allow-confirm",
    "core:window:allow-destroy",
    {
      "identifier": "opener:allow-open-url",
      "allow": [{ "url": "https://github.com/NekoNyangYee/pdf-editor/releases/download/*" }]
    }
  ]
}
